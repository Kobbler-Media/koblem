# koblem environment — copy to `.env` and edit.
# Edit every `CHANGEME` before first start: the API refuses to boot while
# KOBLEM_ADMIN_PASSWORD or KOBLEM_API_KEY is still the placeholder (blank them to
# disable what they gate). Everything else has a working default. `.env` is
# gitignored.

# ---------------------------------------------------------------------------
# Host paths (the only bind mounts in the stack — everything else is a named
# volume). Model weights are tens of GB and genuinely live outside the repo.
# ---------------------------------------------------------------------------

# Where your GGUF model files live. Mounted read-write at /models in
# llama-server. You supply these files; nothing downloads them for you.
KOBLEM_MODELS_DIR=./models

# Sibling checkout of the koblibs workspace, used as a Docker build context for
# the web image and as a cargo/npm path override for native builds.
KOBLIBS_DIR=../koblibs

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

TZ=UTC
RUST_LOG=info

KOBLEM_PORT=8090
KOBLEM_WEB_PORT=8091

KOBLEM_DB_PASSWORD=CHANGEME

# Optional bootstrap admin account, created on first start if both are set.
KOBLEM_ADMIN_EMAIL=
KOBLEM_ADMIN_PASSWORD=CHANGEME

# Optional static bearer token accepted on /api/v1/*, in addition to web-login
# sessions and named API keys created in the UI. Also seeds the signing secret
# for signed media URLs.
KOBLEM_API_KEY=CHANGEME

# ---------------------------------------------------------------------------
# LLM  (docker-compose.llm.yml)
# ---------------------------------------------------------------------------

# llama.cpp base image: server-cuda (NVIDIA), server-rocm (AMD), server (CPU).
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

LLAMA_SERVER_URL=http://llama-server:8080
CONTEXT_SIZE=131072

# Model filenames inside KOBLEM_MODELS_DIR. Leave blank for the entrypoint
# defaults (gemma-4-12B-it-qat-UD-Q4_K_XL.gguf, its F16 unified mmproj, and the
# MTP draft). These specific quants are not published anywhere — supply your own
# GGUFs and name them here.
LLAMA_MODEL=
LLAMA_MMPROJ=
LLAMA_DRAFT_MODEL=

# Optional download sources. If a model file is absent AND its URL is empty the
# container exits rather than starting with a broken model path.
TEXT_URL=
MMPROJ_URL=
DRAFT_URL=
# Sent as a bearer token on model downloads (for gated Hugging Face repos).
HF_TOKEN=

# Attach a slice of the project song to the H3 prompt writer's turn. Off by
# default and unmeasured — see docker-compose.llm.yml. Set to 1 to try it.
KOBLEM_H3_WRITER_SONG_AUDIO=

# ---------------------------------------------------------------------------
# Vision  (docker-compose.vision.yml)
# koblem calls these; it does not run them. Blank disables the feature — and
# blank is the real default here: these are typically a SEPARATE compose
# project (e.g. kobbler's), so the hostname only resolves if koblem-api is on
# that project's docker network too (`docker network connect`, or an
# `external` network in your override). Example values, for kobbler's own
# service names at the time of writing:
#   VISION_SERVICE_URL=http://siglip2:8890
#   MATTING_SERVICE_URL=http://matting:8898
#   DEPTH_SERVICE_URL=http://vision-server:8898
# ---------------------------------------------------------------------------

VISION_SERVICE_URL=
MATTING_SERVICE_URL=
DEPTH_SERVICE_URL=

# ---------------------------------------------------------------------------
# TTS / STT  (docker-compose.tts.yml, docker-compose.stt.yml)
# Same cross-project caveat as Vision above. kobbler's own TTS/STT services
# are named tts-breeze:8203 and stt-parakeet-cpp:8023 — check your own compose
# project's actual service name and port before uncommenting.
#   TTS_BREEZE_SERVICE_URL=http://tts-breeze:8203
#   STT_SERVICE_URL=http://stt-parakeet-cpp:8023
# ---------------------------------------------------------------------------

TTS_BREEZE_SERVICE_URL=
STT_SERVICE_URL=

# ---------------------------------------------------------------------------
# Image / music / avatar  (docker-compose.media.yml)
# All blank by default — each blank URL hides that engine's tab.
# ---------------------------------------------------------------------------

FLUX2_SERVICE_URL=
KREA2_SERVICE_URL=
ACE_SERVER_URL=
AVATAR_SERVER_URL=

# ---------------------------------------------------------------------------
# Not part of any compose file — read directly by the API if set. These are the
# remaining engines and knobs; every one is optional and blank-by-default
# unless noted. Defaults shown in brackets are what the code falls back to.
# ---------------------------------------------------------------------------

# Video / 3D / upscale engines.
LTX25_SERVICE_URL=              # [http://comfy-api:8190] LTX-2.5 via the ComfyUI shim
MUSIC3_SERVICE_URL=             # [http://comfy-api:8190] Music 3
UPSCALE_SERVICE_URL=            # [http://comfy-api:8190] upscaler
PIXAL3D_SERVICE_URL=            # [http://longcat-rig:8102]
LTX_2B_SERVICE_URL=
WAN_VACE_SERVICE_URL=
MINIMAX_H3_SERVICE_URL=
SONGGEN_SERVER_URL=
SA3_SERVER_URL=
# SPAR3D + RigAnything image-to-3D worker.
SPAR3D_SERVICE_URL=

# A second, larger LLM endpoint for jobs that warrant it, plus which job kinds
# may use it and how much VRAM to keep free for it.
BEEFY_LLM_SERVICE_URL=
BEEFY_ALLOW=
BEEFY_RESERVE_MB=
# Label softmax temperature of /api/v1/beefy/systemone (default 1.0).
SYSTEMONE_TEMPERATURE=
DIRECTOR_LLM_SERVICE_URL=

# Optional NATS review consumer. Unset disables it.
NATS_URL=

# Container-internal data directories. The compose files already point these at
# named volumes; override only if you relocate them inside the container.
SAMPLES_DIR=
SONGS_DIR=
AVATARS_DIR=
LTX_JOBS_DIR=
QUEUE_FILES_DIR=
QUEUE_CAPTURE_DIR=
UPSCALE_STAGING_DIR=
DIRECTOR_ASSETS_DIR=
DIRECTOR_RENDERS_DIR=
PIXAL3D_DIR=
PIXAL3D_STAGING_DIR=

# Shared secret for the /oneshot route. Unset keeps the route closed; set one to
# enable it.
ONESHOT_API_KEY=
