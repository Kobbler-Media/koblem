{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, caller, LEFT(response_content, 120) AS message_preview,\n                   streaming, duration_ms, status, completion_tokens,\n                   created_at, updated_at\n            FROM llm_logs\n            WHERE caller = $1\n            ORDER BY (status = 'running') DESC, created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
