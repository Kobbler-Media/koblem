    "@codemirror/view": "^6.43.8",
    "@gltf-transform/core": "^4.4.2",
    "@koblibs/ui": "file:../../koblibs",
    "meshoptimizer": "^1.2.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14"
  }
